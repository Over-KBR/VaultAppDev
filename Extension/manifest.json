{
  "manifest_version": 3,
  "name": "VaultApp",
  "version": "2.0.0",
  "description": "Remplissage automatique des mots de passe depuis VaultApp",

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "http://127.0.0.1:27842/*"
  ],

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon16.png",
    "128": "icons/icon16.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon16.png",
      "128": "icons/icon16.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
