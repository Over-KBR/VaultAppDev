{
  "manifest_version": 2,
  "name": "VaultApp",
  "version": "2.0.0",
  "description": "Remplissage automatique des mots de passe depuis VaultApp",

  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "http://127.0.0.1:27842/*"
  ],

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon16.png",
    "128": "icons/icon116.png"
  },

  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon16.png",
      "128": "icons/icon16.png"
    }
  },

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "vaultapp@local",
      "strict_min_version": "109.0"
    }
  }
}
